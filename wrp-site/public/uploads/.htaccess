# Загрузки пользователей (аватары, обложки): только файлы, никаких скриптов
Options -Indexes -ExecCGI

# PHP как модуль Apache: выключаем выполнение в этой папке
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_php7.c>
  php_flag engine off
</IfModule>
<IfModule mod_php5.c>
  php_flag engine off
</IfModule>

<IfModule mod_mime.c>
  RemoveHandler .php .phtml .phar .pht .phps .php3 .php4 .php5 .php7 .php8 .cgi .pl .py .asp .aspx .shtml
  RemoveType .php .phtml .phar .pht .phps .php3 .php4 .php5 .php7 .php8
</IfModule>

# PHP через CGI / FastCGI (OpenServer): такие файлы вообще не отдаются, в том числе file.php.jpg
<FilesMatch "(?i)\.(php\d?|phtml|phar|pht|phps|cgi|pl|py|asp|aspx|shtml)(\.|$)">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>

<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
